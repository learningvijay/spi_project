database -open waves -into waves.shm -default
probe -create -shm tb_spi_slave_control_select.baudrate_divisor tb_spi_slave_control_select.mstr tb_spi_slave_control_select.p_clk tb_spi_slave_control_select.p_reset tb_spi_slave_control_select.recive_data tb_spi_slave_control_select.send_data tb_spi_slave_control_select.spi_mode tb_spi_slave_control_select.spiswai tb_spi_slave_control_select.ss tb_spi_slave_control_select.tip
run
