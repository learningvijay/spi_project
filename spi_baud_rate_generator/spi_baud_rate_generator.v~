`timescale 1ns/1ps
module spi_baud_rate_generator(
    input p_clk, p_reset, spiswai, cpol, cpha, ss,
    input [1:0]spi_mode,
    input [2:0]sppr,
    input [2:0]spr,
    output reg s_clk,
    output reg miso_receive_s_clk_rising,
    output reg miso_receive_s_clk_falling,
    output reg mosi_send_s_clk_rising,
    output reg mosi_send_s_clk_falling,
    output wire [11:0]spi_baud_rate_divisor
);

wire pre_s_clk;
reg [11:0]count;

// BAUDRATE DIVISOR
assign spi_baud_rate_divisor = ((sppr+3'b001)*(2**(spr+3'b001)));

//s_clk state at idle mode 
assign pre_s_clk=cpol;

//s_clk generation
always@(posedge p_clk or negedge p_reset) begin
    if(!p_reset)begin
        s_clk<=pre_s_clk;
        count<=12'b0;
    end
    else if((((spi_mode==2'b00)||(spi_mode==2'b01))&&(!ss)&&(!spiswai)))begin
        if(count==((spi_baud_rate_divisor/2)-1))begin
            s_clk<=~s_clk;
            count<=12'b0;
        end
        else begin
            count<=count+1'b1;
        end
    end
    else begin
        s_clk<=pre_s_clk;
        count<=12'b0;
    end
end

//MISO sample flages

always@(posedge p_clk or negedge p_reset) begin
    if (!p_reset) begin
        miso_receive_s_clk_rising<=1'b0;
        miso_receive_s_clk_falling<=1'b0;
    end
    else if ((((spi_mode==2'b00)||(spi_mode==2'b01))&&(!ss)&&(!spiswai))) begin
          miso_receive_s_clk_rising<=1'b0;
          miso_receive_s_clk_falling<=1'b0;
        if ((s_clk==1'b0)&&(count==((spi_baud_rate_divisor/2)-1))&&(cpol==cpha)) begin
            miso_receive_s_clk_rising<=1'b1;
        end
        else if((s_clk==1'b1)&&(count==((spi_baud_rate_divisor/2)-1))&&(cpol!=cpha)) begin
            miso_receive_s_clk_falling<=1'b1;
        end
       
        
    end
end

//MOSI sample flag
always@(posedge p_clk or negedge p_reset) begin
    if (!p_reset) begin
       mosi_send_s_clk_rising<=1'b0;
       mosi_send_s_clk_falling<=1'b0;
    end
    else if ((((spi_mode==2'b00)||(spi_mode==2'b01))&&(!ss)&&(!spiswai))) begin
            mosi_send_s_clk_rising<=1'b0;
            mosi_send_s_clk_falling<=1'b0;  
        if ((s_clk==1'b0)&&(count==((spi_baud_rate_divisor/2)-2))&&(cpol==cpha)) begin
             mosi_send_s_clk_rising<=1'b1;
        end
         if((s_clk==1'b1)&&(count==((spi_baud_rate_divisor/2)-2))&&(cpol!=cpha)) begin
              mosi_send_s_clk_falling<=1'b1;
        end
       
        
    end
end


endmodule
