database -open waves -into waves.shm -default
probe -create -shm spi_top_tb.data_from_receive_buffer_reg spi_top_tb.miso spi_top_tb.mosi spi_top_tb.p_addr spi_top_tb.p_clk spi_top_tb.p_data_in spi_top_tb.p_data_out spi_top_tb.p_enable spi_top_tb.p_ready spi_top_tb.p_reset spi_top_tb.p_select spi_top_tb.p_slverr spi_top_tb.p_write spi_top_tb.receive_buffer_reg spi_top_tb.receive_data spi_top_tb.s_clk spi_top_tb.send_data spi_top_tb.spi_interrupt_request spi_top_tb.spidr spi_top_tb.ss
run
exit
